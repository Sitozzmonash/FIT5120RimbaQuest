# Local development uses SQLite unless DATABASE_URL is overridden.
DATABASE_URL=sqlite:///./data/RimbaQuest.db
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081

# Render production: point DATABASE_URL at the Neon pooled connection URI and
# set the private S3-compatible storage credentials issued by Neon.
# DATABASE_URL=postgresql://user:URL_ENCODED_PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb
# AWS_ENDPOINT_URL_S3=https://XXXX.storage.c-2.REGION.aws.neon.tech
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-2
# DATABASE_STORAGE_BUCKET=image
# JWT_SECRET=generate-a-long-random-value
# CORS_ALLOWED_ORIGINS=*
# Server-only Places API (New) key. Never put this in Expo / the client / git.
GOOGLE_PLACES_API_KEY=

# Iteration 2 server-side wildlife verification. Set SCEQUENCE to the exact
# comma-separated failover order you want, for example deepseek,groq,zhipu.
# Missing keys are skipped. Never expose these keys through EXPO_PUBLIC_
# variables or commit a populated .env.
# SCEQUENCE=deepseek,groq,zhipu
PIC_DEEPSEEK_API_KEY=
PIC_DEEPSEEK_VISION_MODEL=deepseek-flash
# PIC_DEEPSEEK_API_BASE_URL=https://api.deepseek.com
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.8-flash
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GROQ_API_BASE_URL=https://api.groq.com/openai/v1
# Epic 6 chat key. This stays on the FastAPI/Render service, never in Expo.
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-chat
# DEEPSEEK_API_BASE_URL=https://api.deepseek.com
# CHAT_TIMEOUT_SECONDS=20
# CHAT_MAX_OUTPUT_TOKENS=80
# Whitelist evidence retrieval. GBIF is public and is limited to taxonomy
# lookups. MyBIS, PERHILITAN and IUCN excerpts must be team-reviewed before
# they are inserted into species_chat_evidence; no arbitrary web scraping.
# Set true only when testing/deploying the bounded GBIF taxonomy retriever.
GBIF_API_ENABLED=false
# GBIF_API_BASE_URL=https://api.gbif.org/v1
# GBIF_TIMEOUT_SECONDS=8
ZHIPU_API_KEY=
ZHIPU_VISION_MODEL=glm-4.6v-flash
# ZHIPU_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
# Compatibility aliases accepted by the backend:
# MODEL_NAME=gemini-3.8-flash
# MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Groq_Qwen3=<Groq API key>
# VISION_MIN_CONFIDENCE=0.65
# VISION_TIMEOUT_SECONDS=20
# DISCOVERY_VERIFICATION_TTL_MINUTES=30
