# Local development uses SQLite unless DATABASE_URL is overridden.
DATABASE_URL=sqlite:///./data/RimbaQuest.db
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081

# Render production: use the Supabase Session pooler URI on port 5432.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# SUPABASE_SECRET_KEY=sb_secret_...
# JWT_SECRET=generate-a-long-random-value
# CORS_ALLOWED_ORIGINS=*
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
