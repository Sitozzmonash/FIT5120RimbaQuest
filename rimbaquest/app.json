{
  "expo": {
    "name": "RimbaQuest",
    "slug": "rimbaquest",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rimbaquest",
    "userInterfaceStyle": "light",
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#1B4416",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.sitozzmonashsteam.rimbaquest"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow RimbaQuest to take a personal wildlife discovery photo.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow RimbaQuest to take a personal wildlife discovery photo.",
          "photosPermission": "Allow RimbaQuest to select a personal wildlife discovery photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B4416",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow RimbaQuest to use your current location to tag where you recorded a wildlife discovery.",
          "locationWhenInUsePermission": "Allow RimbaQuest to use your current location to tag where you recorded a wildlife discovery.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "38bbcfcf-87f3-4003-8ec5-5bcccc181bbb"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/38bbcfcf-87f3-4003-8ec5-5bcccc181bbb"
    }
  }
}
